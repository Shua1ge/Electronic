  "rules": [
    {
      "id": "R01",
      "name": "型号不等于实例",
      "applies_when": "same_model_code",
      "requires": "比较实例标识、角色、网络与位置；不足则待定",
      "forbidden": "相同型号自动合并",
      "counterexample": "同一MODEL-X分别用于密码机和认证网关"
    },
    {
      "id": "R02",
      "name": "网络不等于安全区",
      "applies_when": "zone_or_plane_label",
      "requires": "分开建Network/Plane/SecurityZone",
      "forbidden": "把II区当成第二网络平面",
      "counterexample": "生产控制II区与生产管理III区"
    },
    {
      "id": "R03",
      "name": "容量分层",
      "applies_when": "rate_claim",
      "requires": "按网络、设备、光路、业务属性归属后比较",
      "forbidden": "从10G网络补成10G光路",
      "counterexample": "10G网络承载622M光路与2M业务"
    },
    {
      "id": "R04",
      "name": "接口不等于带宽",
      "applies_when": "interface_claim",
      "requires": "FE归InterfaceSpec，2M归Channel.channel_rate",
      "forbidden": "从FE推断业务申请速率100M",
      "counterexample": "2M通道（FE接口）"
    },
    {
      "id": "R05",
      "name": "数量口径分离",
      "applies_when": "quantity_or_redundancy",
      "requires": "分别记录新增、现有、目标总量、采购量及资源数量",
      "forbidden": "3台新增与2主2备直接比较或补造1台已有",
      "counterexample": "增加3台后实现2主2备"
    },
    {
      "id": "R06",
      "name": "物理缆段不等于资源路径",
      "applies_when": "splice_or_branch",
      "requires": "分开CableSegment/FiberRange/Splice/Circuit",
      "forbidden": "把24芯资源通路当成24芯物理缆段",
      "counterexample": "48芯ADSS在T接点分纤形成多个方向的24芯资源连接"
    },
    {
      "id": "R07",
      "name": "多端关系允许存在",
      "applies_when": "multi_terminal_service",
      "requires": "用多条带端点角色的关系描述多端业务",
      "forbidden": "强制所有保护业务只能有A/Z两端",
      "counterexample": "T接线路三端保护"
    },
    {
      "id": "R08",
      "name": "施工责任不是图中存在性",
      "applies_when": "scope_exclusion",
      "requires": "保存本工程/配套工程/未确定的责任范围",
      "forbidden": "对侧设备出现在说明中就计入本工程量",
      "counterexample": "对侧设备由配套工程负责"
    },
    {
      "id": "R09",
      "name": "阶段分期临时性分离",
      "applies_when": "temporal_claim",
      "requires": "阶段、工程分期、临时性分别标注",
      "forbidden": "把一期二期当成现状目标；把临时直接等同施工阶段",
      "counterexample": "一期与二期各自的新建线路"
    },
    {
      "id": "R10",
      "name": "槽位端口纤芯分别编号",
      "applies_when": "resource_identifier",
      "requires": "沿所属设备/光缆限定编号作用域",
      "forbidden": "把#6槽位当成6号纤芯或端口",
      "counterexample": "槽位#6与光缆1,2芯"
    },
    {
      "id": "R11",
      "name": "图例解释有作用域",
      "applies_when": "legend_match",
      "requires": "保存图例来源、页面/图组范围、歧义候选",
      "forbidden": "把一页菱形符号含义推广所有工程",
      "counterexample": "相似图元对应保护、稳控或测距"
    },
    {
      "id": "R12",
      "name": "未提取不是不存在",
      "applies_when": "missing_observation",
      "requires": "先查覆盖与来源，再产生缺项核对任务",
      "forbidden": "以未识别为零工程量",
      "counterexample": "浅灰线漏识"
    },
    {
      "id": "R13",
      "name": "型号文本精确保留",
      "applies_when": "model_token",
      "requires": "型号原文完整保存，数量另取明确数词",
      "forbidden": "自动去掉型号开头3-或合并V2/V3",
      "counterexample": "3-NL-Q2288HV6(V5)"
    },
    {
      "id": "R14",
      "name": "重复文档不是独立证据",
      "applies_when": "repeated_page",
      "requires": "按源文档/修订/页表达追踪依赖与别名",
      "forbidden": "合订本与单张图重复计数或虚增置信度",
      "counterexample": "组合1.pdf和单图同页"
    },
    {
      "id": "R15",
      "name": "规范要求不是竣工事实",
      "applies_when": "modal_text",
      "requires": "区分asserted_fact/requirement/expectation/derived",
      "forbidden": "把应接地或应独立敷设当成已确认施工状态",
      "counterexample": "需两条完全独立路径"
    }
  ],
  "policy": {
    "open_world": true,
    "same_name_implies_identity": false,
    "model_output_can_confirm": false,
    "quantity_creates_instances": false,
    "auto_promote_to_business_facts": false
  }
